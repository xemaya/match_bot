// 命名契约见 AGENTS.md §4：模型 PascalCase 单数，字段 camelCase，表/列 snake_case 复数，
// 主键 id (cuid)，外键 xxxId，时间 xxxAt (timestamptz, UTC)，布尔 is/has 前缀，金额 pence 整数。

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  feishu
  telegram
  whatsapp
}

enum DemandCategory {
  man_and_van
  eot_cleaning
  furniture_service
  housing
  job
  second_hand
  other
}

enum DemandStatus {
  open
  clarifying
  matched
  closed
  expired
}

enum ExecutionStatus {
  accepted
  running
  waiting_approval
  completed
  failed
}

enum TaskStatus {
  active
  waiting_user
  waiting_source
  waiting_delivery
  delivered
  completed
  cancelled
  expired
}

enum SupplierPool {
  A
  B
}

enum OutboundStatus {
  dry_run
  pending
  sending
  sent
  failed
  delivery_unknown
}

/// 出站消息的用途。频控只数 recommendation（PRD §6.2：像广告的是反复推荐，不是回应追问）。
enum OutboundKind {
  recommendation
  clarification
  notification
  lead
  reaction // 给用户消息加表情（text 存 emoji，reply_to_message_id 是被加表情的消息）
}

enum RunStateStatus {
  pending
  consumed
  expired
}

enum TraceKind {
  rule
  jev
  agent_run
  gate
}

model User {
  channelScope String @default("") @map("channel_scope")
  id           String   @id @default(cuid())
  channel      Channel
  externalId   String   @map("external_id") // Telegram user id 等，字符串存
  languages    String[] // ISO 639-1
  homePostcode String?  @map("home_postcode")
  profile      Json     @default("{}")
  lastSeenAt   DateTime @map("last_seen_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  executionLeaseToken String? @map("execution_lease_token")
  executionLeaseExpiresAt DateTime? @map("execution_lease_expires_at") @db.Timestamptz
  executionFence Int @default(0) @map("execution_fence")

  messages     Message[]
  demands      Demand[]
  supplies     Supply[]
  sessionItems SessionItem[]
  runStates    RunState[]
  tasks        Task[]

  @@unique([channel, externalId, channelScope], name: "channel_externalId")
  @@map("users")
}

model Group {
  channelScope String @default("") @map("channel_scope")
  id                String   @id @default(cuid())
  channel           Channel
  externalId        String   @map("external_id")
  name              String
  phase             Int      @default(0) // 0 shadow / 1 review / 2 auto
  categoriesEnabled String[] @map("categories_enabled")
  adminContact      String?  @map("admin_contact")
  rateLimitPerDay   Int?     @map("rate_limit_per_day") // 每天最多推荐几次；空 = 不限（2026-09-25 起默认不限）
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  messages Message[]
  supplies Supply[]

  @@unique([channel, externalId, channelScope], name: "channel_externalId")
  @@map("groups")
}

model Message {
  channelRoute Json? @map("channel_route")
  id         String   @id @default(cuid())
  groupId    String?  @map("group_id")
  userId     String   @map("user_id")
  externalId String   @map("external_id") // 渠道 message id
  text       String   // 保留 30 天后置空，见架构 §9
  textHash   String   @map("text_hash")
  lang       String?
  receivedAt DateTime @map("received_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  executionKey String? @unique @map("execution_key")
  executionStatus ExecutionStatus? @map("execution_status")
  executionPhase Int @default(0) @map("execution_phase")
  executionAttempts Int @default(0) @map("execution_attempts")
  executionFence Int? @map("execution_fence")
  executionSnapshot String? @map("execution_snapshot")
  executionError String? @map("execution_error")
  executionQueuedAt DateTime? @map("execution_queued_at") @db.Timestamptz
  replyToMessageId String? @map("reply_to_message_id")
  isAddressedToBot Boolean @default(false) @map("is_addressed_to_bot")
  replyToBotText String? @map("reply_to_bot_text")
  taskId String? @map("task_id")
  taskRequirementsVersion Int? @map("task_requirements_version")

  group Group? @relation(fields: [groupId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId],references: [id],onDelete: SetNull)
  runStates RunState[]
  outbounds OutboundMessage[]

  @@unique([groupId, externalId])
  @@index([userId, receivedAt])
  @@index([userId,executionStatus,receivedAt])
  @@map("messages")
}

model Demand {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  taskId           String?        @unique @map("task_id")
  task             Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  category         DemandCategory
  status           DemandStatus   @default(open)
  need             String?        // 在找什么（简短英文）；库外需求 web search 的查询来源
  whenText         String?        @map("when_text")
  whenAt           DateTime?      @map("when_at") @db.Timestamptz
  fromPostcode     String?        @map("from_postcode")
  toPostcode       String?        @map("to_postcode")
  quantity         String?
  budgetPence      Int?           @map("budget_pence")
  lang             String?
  confidence       Float
  isMoveEvent      Boolean        @default(false) @map("is_move_event")
  sourceMessageIds String[]       @map("source_message_ids")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id])
  matches Match[]

  @@index([userId, status])
  @@map("demands")
}

/// PRD §13: one scoped user objective; operational revision and requirements version are distinct.
model Task {
  threadId String @default("") @map("thread_id")
  id                  String         @id @default(cuid())
  userId              String         @map("user_id")
  channel             Channel
  chatId              String         @map("chat_id")
  sourceMessageId     String         @map("source_message_id")
  intentKey           String         @map("intent_key")
  originHash          String         @map("origin_hash")
  category            DemandCategory
  status              TaskStatus     @default(active)
  revision            Int            @default(0)
  requirementsVersion Int            @default(0) @map("requirements_version")
  state               Json
  lastUserActivityAt  DateTime       @map("last_user_activity_at") @db.Timestamptz
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events TaskEvent[]
  messages Message[]
  outbounds OutboundMessage[]
  demand Demand?

  @@unique([userId, channel, chatId, sourceMessageId, intentKey])
  @@index([userId, channel, chatId, status])
  @@index([lastUserActivityAt])
  @@map("tasks")
}

/// Append-only checkpoints expire with task personal data after 30 inactive days (PRD §13).
model TaskEvent {
  id              String   @id @default(cuid())
  taskId          String   @map("task_id")
  revision        Int
  operationKey    String   @map("operation_key")
  requestHash     String   @map("request_hash")
  kind            String
  actorKind       String   @map("actor_kind")
  sourceMessageId String?  @map("source_message_id")
  checkpoint      Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, revision])
  @@unique([taskId, operationKey])
  @@map("task_events")
}

model Supply {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  groupId         String         @map("group_id")
  category        DemandCategory
  availability    String?
  area            String?
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz
  sourceMessageId String         @map("source_message_id")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])
  matches Match[]

  @@index([category, expiresAt])
  @@map("supplies")
}

model Supplier {
  id                     String       @id @default(cuid())
  category               DemandCategory
  name                   String
  phone                  String?
  email                  String?   // 商家公开邮箱，B→A 池转化的联系渠道之一
  whatsapp               String?
  telegram               String?
  website                String?
  serviceArea            String[]     @map("service_area") // outward codes 或 "LONDON"
  basePostcode           String?      @map("base_postcode")
  priceType              String?      @map("price_type") // hourly / fixed / quote
  roughPrice             String?      @map("rough_price")
  isSameDay              Boolean      @default(false) @map("is_same_day")
  isWeekend              Boolean      @default(false) @map("is_weekend")
  languages              String[]
  rating                 Float?
  reviewCount            Int?         @map("review_count")
  source                 String?
  sourceUrl              String?      @map("source_url")
  pool                   SupplierPool @default(B)
  lastVerifiedAt         DateTime?    @map("last_verified_at") @db.Timestamptz
  isContacted            Boolean      @default(false) @map("is_contacted")
  isWillingToReceiveLeads Boolean     @default(false) @map("is_willing_to_receive_leads")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  matches Match[]

  @@index([category, pool])
  @@map("suppliers")
}

model Match {
  id           String   @id @default(cuid())
  demandId     String   @map("demand_id")
  supplierId   String?  @map("supplier_id")
  supplyId     String?  @map("supply_id")
  matcherScore Float    @map("matcher_score")
  jevFit       Float?   @map("jev_fit")
  rank         Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  demand   Demand    @relation(fields: [demandId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  supply   Supply?   @relation(fields: [supplyId], references: [id])
  leads    Lead[]

  @@index([demandId, rank])
  @@map("matches")
}

model Lead {
  id               String    @id @default(cuid())
  matchId          String    @map("match_id")
  sentVia          Channel   @map("sent_via")
  sentAt           DateTime  @map("sent_at") @db.Timestamptz
  supplierResponse String?   @map("supplier_response") // quote / pass / none
  isConverted      Boolean   @default(false) @map("is_converted")
  isPaid           Boolean   @default(false) @map("is_paid")
  followedUpAt     DateTime? @map("followed_up_at") @db.Timestamptz

  match Match @relation(fields: [matchId], references: [id])

  @@map("leads")
}

/// OpenAI Agents SDK Session 存储：一个用户一个 session。
model SessionItem {
  scopeKey String @default("") @map("scope_key")
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  seq         Int
  item        Json
  operationId String?  @map("operation_id") // SessionHistoryTransactionAwareSession 幂等
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, scopeKey, seq])
  @@index([userId, scopeKey, operationId])
  @@map("session_items")
}

/// HITL 快照。snapshot 为 RunState.toString()，落库前加密（架构 §9）。
model RunState {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  chatId        String         @map("chat_id") // 审批通过后回原群用
  phase         Int // 快照产生时的阶段，恢复时校验
  snapshot      String
  agentVersion  String         @map("agent_version")
  sdkVersion    String         @map("sdk_version")
  status        RunStateStatus @default(pending)
  interruptions Json
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  consumedAt    DateTime?      @map("consumed_at") @db.Timestamptz
  messageId String? @map("message_id")

  user      User       @relation(fields: [userId], references: [id])
  approvals Approval[]
  outboundCard OutboundMessage?
  message Message? @relation(fields: [messageId],references: [id],onDelete: SetNull)

  @@index([status, expiresAt])
  @@map("run_states")
}

model Approval {
  id         String   @id @default(cuid())
  runStateId String   @map("run_state_id")
  reviewer   String
  decision   String   // approve / reject / edit / ignore
  editedText String?  @map("edited_text")
  decidedAt  DateTime @default(now()) @map("decided_at") @db.Timestamptz
  resumeStatus ExecutionStatus? @map("resume_status")
  resumeQueuedAt DateTime? @map("resume_queued_at") @db.Timestamptz
  resumeAttempts Int @default(0) @map("resume_attempts")
  resumeFence Int? @map("resume_fence")
  resumeError String? @map("resume_error")

  runState RunState @relation(fields: [runStateId], references: [id])

  @@index([resumeStatus, resumeQueuedAt])
  @@map("approvals")
}

model OutboundMessage {
  threadId String? @map("thread_id")
  id         String         @id @default(cuid())
  channel    Channel
  target     String         // chat id / user id / supplier contact
  text       String
  status     OutboundStatus @default(pending)
  phase      Int            @default(0)
  kind       OutboundKind   @default(recommendation)
  toolCallId String?        @map("tool_call_id")
  replyToMessageId String? @map("reply_to_message_id") // 群内回帖对应的原消息
  mentionUserId    String? @map("mention_user_id")     // 发送时 @ 的用户；只存 id
  error      String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  sentAt     DateTime?      @map("sent_at") @db.Timestamptz
  leaseToken String?        @map("lease_token")
  leaseExpiresAt DateTime?  @map("lease_expires_at") @db.Timestamptz
  attemptStartedAt DateTime? @map("attempt_started_at") @db.Timestamptz
  attemptCount Int          @default(0) @map("attempt_count")
  nextAttemptAt DateTime?   @map("next_attempt_at") @db.Timestamptz
  externalMessageId String? @map("external_message_id")
  senderAccountId String @default("") @map("sender_account_id")
  sourceMessageId String? @map("source_message_id")
  requestKey String? @unique @map("request_key")
  approvalRunStateId String? @unique @map("approval_run_state_id")
  approvalRunState RunState? @relation(fields: [approvalRunStateId], references: [id], onDelete: SetNull)
  taskId String? @map("task_id")
  taskRequirementsVersion Int? @map("task_requirements_version")
  task Task? @relation(fields: [taskId],references: [id],onDelete: SetNull)
  sourceMessage Message? @relation(fields: [sourceMessageId],references: [id],onDelete: SetNull)

  @@index([status, createdAt])
  @@index([target, kind, sentAt])
  @@index([status, leaseExpiresAt])
  @@unique([channel, senderAccountId, target, externalMessageId])
  @@map("outbound_messages")
}

/// 每一次判断留痕：规则、Jev、agent run、门。评测与看板的唯一来源。
model DecisionTrace {
  id        String    @id @default(cuid())
  kind      TraceKind
  inputRef  String    @map("input_ref") // message id / run id 等
  output    Json
  phase     Int
  latencyMs Int       @map("latency_ms")
  costMicro Int       @default(0) @map("cost_micro") // 美元微分（1e-6 USD）
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([kind, createdAt])
  @@index([inputRef])
  @@map("decision_traces")
}
