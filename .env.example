# ---- 基础设施 ----
DATABASE_URL=postgresql://matchbot:matchbot@localhost:5432/matchbot
REDIS_URL=redis://localhost:6379

# ---- 模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Separate credential is required for DeepSeek search if generation uses another host.
# DEEPSEEK_SEARCH_API_KEY=
# GENERATION_REASONING_EFFORT=low
JEV_API_KEY=
# targeted: direct admission and exact fixed status do not require Jev; facts still do.
# strict restores the previous policy. Runtime default without this setting remains strict.
JEV_POLICY=targeted
JEV_BASE_URL=https://openrouter.ai/api/alpha   # Jev 经 OpenRouter decisions 端点；POST {JEV_BASE_URL}/decisions。直连是 https://api.typesafe.ai/v1 + /systemone
JEV_MODEL=typesafe/jev-1.13

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=            # 运营审批群 chat id（Phase 1 审批台）

# ---- 运行 ----
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_PHASE=0                  # 0 shadow / 1 review / 2 auto；群级配置可覆盖
OUTBOUND_UNSURE_ACTION=drop      # Phase 2 拿不准时：drop 不发（无人值守）/ review 送运营群审批
SNAPSHOT_KEY=                    # run_states 快照加密口令，>=16 字符；Phase 1 起必需
INFORMATION_SEARCH_PROVIDER=deepseek
SEARCH_API_KEY=                  # 可选Tavily商家核验key；网页信息研究默认使用DeepSeek key
SANDBASE_API_KEY=                # 小红书搜索（Sandbase）；可从本机shell环境注入，不配则不注册小红书工具

# Multi-query lifestyle research; enable explicitly per environment
XHS_RESEARCH_ENABLED=false

# Explicit synthetic actor admission. Empty by default; exact test group + actor bot IDs only.
TELEGRAM_ACTOR_ALLOWLIST='[]'
# Private 0600 JSON, created after BotFather/group setup.
# ACTOR_LAB_CONFIG_PATH=.env.actor-lab.json

# P40 host / DSH channels (legacy dev:bot remains Telegram-only)
CHANNEL_MODE=telegram
CHANNEL_INSTALLATION_ID=local
# Comma-separated numeric Telegram user IDs, required to approve in the new host.
TELEGRAM_REVIEWERS=
# Required only when CHANNEL_MODE=feishu or both. Keep credentials in a local env file.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_ID=
FEISHU_REGION=feishu
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=
FEISHU_OPS_CHAT_ID=
FEISHU_REVIEWERS=
