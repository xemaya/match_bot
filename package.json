{
  "name": "match-bot",
  "private": true,
  "version": "0.0.0",
  "description": "London Community Matching Bot — Telegram 群供需撮合",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint . && node scripts/check-deps.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "pnpm --filter @matchbot/eval exec tsx src/cli.ts",
    "prompt:audit": "node --import tsx scripts/local/prompt-audit.mts",
    "humanness": "pnpm --filter @matchbot/eval exec tsx src/humanness/cli.ts",
    "humanness:record": "node --import tsx scripts/local/humanness-record.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "dev:bot": "pnpm --filter @matchbot/bot dev",
    "dev:worker": "pnpm --filter @matchbot/worker dev",
    "db:generate": "pnpm --filter @matchbot/db generate",
    "db:migrate": "pnpm --filter @matchbot/db migrate",
    "db:studio": "pnpm --filter @matchbot/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@openai/agents": "^0.18.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "grammy": "^1.46.0",
    "openai": "^7.20.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
